# Copia este archivo como .env y completa los valores.

# Clave secreta para las sesiones (genera una con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# --- Correo ---
# archivo = modo de prueba (guarda los correos en instance/correos_prueba, no envía nada)
# smtp    = envío real con tu correo corporativo
SMTP_MODO=archivo
SMTP_HOST=mail.amglogisticsco.com
SMTP_PORT=465
SMTP_SEGURIDAD=ssl          # ssl (puerto 465, HostGator) | tls (puerto 587) | ninguna
SMTP_USUARIO=comercial@amglogisticsco.com
SMTP_CLAVE=
SMTP_REMITENTE=comercial@amglogisticsco.com
# Opcional: recibir copia oculta de todo lo que se envía
SMTP_COPIA_OCULTA=info@amglogisticsco.com

# --- Cumpleaños ---
ZONA_HORARIA=America/Bogota
CUMPLE_HORA=8
